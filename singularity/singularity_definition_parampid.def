Bootstrap: docker
From: python:3.6-slim

%help
    Container for paramPID classification with necessary dependencies and KM3NeT's jppy.

%files
    ./parampid_hannes /parampid
    ./jpp /jpp
    ./newhitfeatures_hannes /newhitfeatures
    ./jppy /jppy
    ./parampid_requirements.txt /parampid_requirements.txt

%post
    # Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev \
        python3-venv \
        cmake \
        git \
        libssl-dev \
        pybind11-dev \
        libhdf5-dev \
        hdf5-tools \
        ssh-client \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Create and install virtual environment
    python3 -m venv /venv
    /venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

    # Install Python dependencies
    /venv/bin/pip install -r /parampid_requirements.txt
    /venv/bin/pip install fastprogress # maybe after jppy and so on??


    # Install the newhitfeatures package
    cd /newhitfeatures
    /venv/bin/pip install -e .
    cd ..

    cd /parampid
    /venv/bin/pip install -e .
    cd ..

    cd /jppy
    /venv/bin/pip install -e .
    cd ..

    . /venv/bin/activate

%environment
    # Set environment variables for the container
    export PATH=/venv/bin:$PATH
    export PYTHONPATH=/parampid:$PYTHONPATH
    export JPP_DIR=/jpp

%runscript
    # Default command when running the container
    echo "Singularity container for paramPID is ready!"
    exec "$@"

%test
    # Test installation
    /venv/bin/python3 -c "import jppy; print('jppy loaded successfully')"
    /venv/bin/python3 -c "print('paramPID container works')"