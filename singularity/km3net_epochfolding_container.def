Bootstrap: docker
From: ubuntu:20.04

%post
    # Update system and install dependencies
    apt-get update && apt-get install -y \
        python3 \
        python3-pip \
        python3-venv \
        git \
        build-essential \
        libpython3-dev

    # Set up virtual environment
    python3 -m venv /opt/km3astrovenv
    . /opt/km3astrovenv/bin/activate

    # Install required Python packages
    pip install --upgrade pip
    pip install km3io km3astro km3pipe astropy stingray matplotlib pandas numpy h5py scipy

    # Clean up
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    # Activate the virtual environment by default
    source /opt/km3astrovenv/bin/activate
    export PATH=/opt/km3astrovenv/bin:$PATH

%runscript
    # Default behavior when the container is executed
    echo "Running in km3astro Singularity container"
    /bin/bash
