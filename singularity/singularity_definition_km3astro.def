Bootstrap: docker
From: python:3.6-slim

%help
    Container for paramPID classification with necessary dependencies and KM3NeT's jppy.

%files
    ./km3astro_requirements.txt /km3astro_requirements.txt

%post
    # Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev \
        python3-venv \
        cmake \
        git \
        libssl-dev \
        pybind11-dev \
        libhdf5-dev \
        hdf5-tools \
        ssh-client \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Create and install virtual environment
    python3 -m venv /venv
    /venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

    # Install Python dependencies
    pip install -r /km3astro_requirements.txt

%environment
    # Set environment variables for the container
    export PATH=/venv/bin:$PATH

%runscript
    # Default command when running the container
    echo "Singularity container for km3astro is ready!"
    exec "$@"

%test
    # Test installation
    /venv/bin/python3 -c "print('km3astro container works')"