manifest {	
  author = 'Rodrigo G.Ruiz <rgracia@km3net.de>'
  author = 'Katharina Jurk <katharina.kj.jurk@fau.de>'
  author = 'Hannes Warnhofer <hannes.warnhofer@fau.de>'
  description = 'Configuration file defining cluster specific options.'
  nextflowVersion = '24.10.1'
  version = '0.1.0'  
}
env {
  WORKFLOW_DIR = "${PWD}"
}
/*
plugins {
  id 'nf-boost'
}

boost {
  cleanup = true
}
*/
profiles {
  woody_hannes_cluster {
  		  
    singularity {
      enabled = false
      autoMounts = false
      runOptions = "-B /home/saturn/ "
    }

    params {
           output_dir = "/home/hpc/capn/capn107h/software/nextflow_output/parampid";
           log_dir = "/home/hpc/capn/capn107h/software/nextflow_output_log";
    }


    process {
      executor = 'slurm'

      publishDir {
        path = '/home/hpc/capn/capn107h/software/nextflow_output'
        mode = 'copy'
	      overwrite = true
      }

      clusterOptions = '--time=24:00:00 --mail-user=hwarnhofer@km3net.de --mem=8G'

      
    }
  }

  woody_hannes_local {
  		  
    singularity {
      enabled = true
      autoMounts = false
      runOptions = "-B /home/saturn/ "
    }

    params {
    	     input_file = "/home/hpc/capn/capn107h/software/psr/workflows/km3net/km3net_analysis/inputs/km3net_inputs_analysis.nf";
           output_dir = "/home/hpc/capn/capn107h/software/nextflow_output";
           log_dir = "/home/hpc/capn/capn107h/software/nextflow_output_log";
    }


    process {
      executor = 'local'

      publishDir {
        path = '/home/hpc/capn/capn107h/software/nextflow_output'
        mode = 'copy'
	      overwrite = true
      }

      clusterOptions = '--time=24:00:00 --mail-user=hwarnhofer@km3net.de --mem=8G'

      
    }
  }
  
  woody_hannes_container_analysis {
  		  
    singularity {
      enabled = true
      autoMounts = false
      runOptions = "-B /home/hpc/capn/capn107h/software:/mnt/software -B /home/hpc/capn/capn107h/software/nextflow_output:/mnt/output"
    }

    params {
    	     input_file = "/home/hpc/capn/capn107h/software/psr/workflows/km3net/km3net_parameter_study/inputs/km3net_inputs_analysis.nf";
           output_dir = "/home/hpc/capn/capn107h/software/nextflow_output";
           log_dir = "/home/hpc/capn/capn107h/software/nextflow_output_log";
    }

    process {
      executor = 'local'

      publishDir {
        path = '/home/hpc/capn/capn107h/software/nextflow_output'
        mode = 'copy'
	      overwrite = true
      }

      container = '/home/hpc/capn/capn107h/software/singularity_testdir/km3net_km3astro_container.sif'
      
    }
  }


}
