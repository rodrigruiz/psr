manifest {	
  author = 'Rodrigo G.Ruiz <rgracia@km3net.de>'
  author = 'Katharina Jurk <katharina.kj.jurk@fau.de>'
  author = 'Hannes Warnhofer <hannes.warnhofer@fau.de>'
  description = 'Configuration file defining cluster specific options.'
  nextflowVersion = '24.04.3'
  version = '0.1.0'  
}
env {
  WORKFLOW_DIR = "${PWD}"
}
profiles {
  woody_hannes_arca_data {
  		  
    singularity {
      enabled = true
      autoMounts = false
      runOptions = "-B /home/hpc/capn/capn107h/software:/mnt/software -B /home/hpc/capn/capn107h/software/nextflow_output:/mnt/output"
    }

    params {
    	     input_file = "/home/hpc/capn/capn107h/software/psr/workflows/km3net/km3net_atm_weights/km3net_inputs_atm_weights.nf";
           output_dir = "/home/hpc/capn/capn107h/software/nextflow_output";
           log_dir = "/home/hpc/capn/capn107h/software/nextflow_output_log";
    }


    process {
      executor = 'local'

      publishDir {
        path = '/home/hpc/capn/capn107h/software/nextflow_output'
        mode = 'copy'
	      overwrite = true
      }

      container = '/home/hpc/capn/capn107h/software/singularity_testdir/swim_km3flux.sif'
      
    }
  }

woody_hannes_arca_data_slurm {
    
    singularity {
      enabled = true
      autoMounts = false
      runOptions = "-B /home/hpc/capn/capn107h/software:/mnt/software -B /home/hpc/capn/capn107h/software/nextflow_output:/mnt/output"
    }

    params {
      input_file = "/home/hpc/capn/capn107h/software/psr/workflows/km3net/km3net_parampid/inputs/km3net_parampid_inputs_arca_data.nf";
      output_dir = "/home/hpc/capn/capn107h/software/nextflow_output/parampid";
      log_dir = "/home/hpc/capn/capn107h/software/nextflow_output_log";
    }

    process {
      executor = 'slurm'  // Use Slurm executor

      // Define the default memory and CPU settings for processes
      cpus = 2
      memory = '8GB'
      time = '12h'

      publishDir {
        path = '/home/hpc/capn/capn107h/software/nextflow_output'
        mode = 'copy'
        overwrite = true
      }

      container = '/home/hpc/capn/capn107h/software/singularity_testdir/km3net_parampid_container.sif'

      // Specific resource allocations for certain tasks
      withLabel: 'short' {
        cpus = 4
        memory = '20GB'
        queue = 'work'
      }

      withLabel: 'long' {
        cpus = 8
        memory = '32GB'
        queue = 'work'
      }
    }
  }


woody_hannes_orca_data {
  		  
    singularity {
      enabled = true
      autoMounts = false
      runOptions = "-B /home/hpc/capn/capn107h/software:/mnt/software -B /home/hpc/capn/capn107h/software/nextflow_output:/mnt/output"
    }

    params {
    	     input_file = "/home/hpc/capn/capn107h/software/psr/workflows/km3net/km3net_atm_weights/km3net_inputs_atm_weights.nf";
           output_dir = "/home/hpc/capn/capn107h/software/nextflow_output";
           log_dir = "/home/hpc/capn/capn107h/software/nextflow_output_log";
    }


    process {
      executor = 'local'

      publishDir {
        path = '/home/hpc/capn/capn107h/software/nextflow_output'
        mode = 'copy'
	      overwrite = true
      }

      container = '/home/hpc/capn/capn107h/software/singularity_testdir/swim_km3flux.sif'
      
    }
  }
  
}
